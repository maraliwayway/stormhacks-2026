# Copy to .env and fill in. Never commit .env.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=

# ElevenLabs voice IDs per persona (premade voices, available on every account)
VOICE_ID_NARRATOR=JBFqnCBsd6RMkjVDRZzb
VOICE_ID_CHEF=N2lVS1w4EtoT3dr4eOWO
VOICE_ID_ANNOUNCER=

# Models. eleven_v3 understands [audio tags] for the pre-rendered lines; Flash is for the live roast.
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_FLASH_MODEL=eleven_flash_v2_5
GEMINI_MODEL=gemini-3.5-flash-lite

# Frontend origins for CORS, comma-separated
FRONTEND_ORIGIN=http://localhost:5173

# Optional: where the SQLite leaderboard lives (defaults to backend/data/flappy_arms.db)
# DB_PATH=
