# Copy to .env and fill in. Never commit .env.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=

# ElevenLabs voice IDs per persona (pick with the PM in the ElevenLabs voice library)
VOICE_ID_CHEF=
VOICE_ID_ANNOUNCER=

# Models
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_FLASH_MODEL=eleven_flash_v2_5
GEMINI_MODEL=gemini-2.5-flash

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173
