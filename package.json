{
  "name": "flappy-arms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:camera": "node scripts/camera-smoke.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^26.6.4",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
